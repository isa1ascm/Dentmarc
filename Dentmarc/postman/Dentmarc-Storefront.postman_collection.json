{
  "info": {
    "_postman_id": "d4c804b6-6b15-4701-a900-6073c3b38b57",
    "name": "Dentmarc - Storefront API",
    "description": "Peticiones derivadas de las pantallas de catálogo, inicio de sesión, registro, cuenta y carrito del storefront.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "jwt", "value": "" },
    { "key": "productId", "value": "1" },
    { "key": "categoryId", "value": "1" }
  ],
  "item": [
    {
      "name": "Autenticación",
      "item": [
        {
          "name": "Iniciar sesión de cliente",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"email\":\"mariana@clinicadental.mx\",\"contrasenia\":\"Cliente123!\"}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/api/v1/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "login"] }
          },
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": ["pm.test('Login correcto', function () { pm.response.to.have.status(200); });", "pm.environment.set('jwt', pm.response.json().token);"]
            }
          }]
        },
        {
          "name": "Registrar cliente",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"nombre\":\"Cliente\",\"apellidos\":\"Postman\",\"email\":\"cliente-{{$guid}}@example.com\",\"telefono\":\"5512345678\",\"tipoPractica\":\"CLINICA\",\"contrasenia\":\"Cliente123!\"}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/api/v1/auth/register", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "register"] }
          },
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": ["pm.test('Cuenta creada', function () { pm.response.to.have.status(201); });", "pm.environment.set('jwt', pm.response.json().token);"]
            }
          }]
        }
      ]
    },
    {
      "name": "Catálogo",
      "item": [
        {
          "name": "Listar categorías activas",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/v1/categories", "host": ["{{baseUrl}}"], "path": ["api", "v1", "categories"] }
          }
        },
        {
          "name": "Buscar productos",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/products?search={{search}}&categoryId={{categoryId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "products"],
              "query": [
                { "key": "search", "value": "{{search}}" },
                { "key": "categoryId", "value": "{{categoryId}}" }
              ]
            }
          }
        },
        {
          "name": "Ver producto",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/v1/products/{{productId}}", "host": ["{{baseUrl}}"], "path": ["api", "v1", "products", "{{productId}}"] }
          }
        }
      ]
    },
    {
      "name": "Cuenta y carrito (requieren JWT)",
      "item": [
        {
          "name": "Consultar cuenta",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwt}}" }],
            "url": { "raw": "{{baseUrl}}/api/v1/account", "host": ["{{baseUrl}}"], "path": ["api", "v1", "account"] }
          }
        },
        {
          "name": "Consultar carrito",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwt}}" }],
            "url": { "raw": "{{baseUrl}}/api/v1/cart", "host": ["{{baseUrl}}"], "path": ["api", "v1", "cart"] }
          }
        },
        {
          "name": "Agregar producto",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwt}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"productId\":{{productId}},\"cantidad\":1}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/api/v1/cart/items", "host": ["{{baseUrl}}"], "path": ["api", "v1", "cart", "items"] }
          }
        },
        {
          "name": "Actualizar cantidad",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwt}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"cantidad\":2}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/api/v1/cart/items/{{productId}}", "host": ["{{baseUrl}}"], "path": ["api", "v1", "cart", "items", "{{productId}}"] }
          }
        },
        {
          "name": "Quitar producto",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwt}}" }],
            "url": { "raw": "{{baseUrl}}/api/v1/cart/items/{{productId}}", "host": ["{{baseUrl}}"], "path": ["api", "v1", "cart", "items", "{{productId}}"] }
          }
        }
      ]
    }
  ]
}
